---
/**
 * Inicio — basado en la maqueta A7 aprobada. Orden y alternancia claro/oscuro: docs/SPEC.md §2.
 * 2026-10-22: se quitaron Sectores y Cómo trabajamos (sus componentes se reutilizan en las páginas de servicio);
 * Clientes pasa a franja compacta bajo el hero; FAQ pasa a claro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Intro from '../components/home/Intro.astro';
import Hero from '../components/home/Hero.astro';
import Servicios from '../components/home/Servicios.astro';
import PorQue from '../components/home/PorQue.astro';
import Proyectos from '../components/home/Proyectos.astro';
import Certificaciones from '../components/home/Certificaciones.astro';
import Clientes from '../components/home/Clientes.astro';
import Faq from '../components/home/Faq.astro';
import Cotizar from '../components/home/Cotizar.astro';
---

<BaseLayout
  title="Mantenimiento de locales comerciales en Lima"
  description="Mantenimiento de locales comerciales, implementación de tiendas, obras civiles y certificado ITSE (Defensa Civil) en Lima, Ica y provincias. Cotiza hoy."
>
  <Header slot="header" />
  <Intro />
  <Hero />
  <Clientes />
  <Servicios />
  <PorQue />
  <Proyectos />
  <Certificaciones />
  <Faq />
  <Cotizar />
  <Footer slot="footer" />
</BaseLayout>
