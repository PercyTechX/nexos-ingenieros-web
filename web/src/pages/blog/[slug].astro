---
/**
 * Artículo del blog: hero oscuro (ruta, categoría, H1, resumen, fecha y lectura) · portada · índice + cuerpo + CTA lateral ·
 * proyectos relacionados · artículos del mismo pilar · cotizador con el pilar preseleccionado.
 * Borradores: noindex, aviso arriba y los comentarios <!-- VALIDAR / PRECIO CLIENTE / CASO CLIENTE --> se muestran como notas.
 */
import '../../styles/article.css';
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Cotizar from '../../components/home/Cotizar.astro';
import Icon from '../../components/ui/Icon.astro';
import { ICON } from '../../components/ui/icons';
import { SITE, whatsappUrl } from '../../config/site';
import { categoryOf, formatDate, getPosts, pillarOf, readingTime, type Post } from '../../lib/blog';
import { breadcrumbLd } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const cat = categoryOf(d.pillar);
const pillar = pillarOf(d.pillar);
const url = `/blog/${post.id}/`;
const minutes = readingTime(post.body);
const projects = d.relatedProjects.length ? await getEntries(d.relatedProjects.map((id) => ({ collection: 'proyectos' as const, id }))) : [];
const related = all.filter((p) => p.id !== post.id && p.data.pillar === d.pillar).slice(0, 3);
const quote = `/?servicio=${d.pillar}#cotizar`;

const jsonLd = [
  breadcrumbLd([
    { name: 'Inicio', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: cat.label, url: `/blog/categoria/${cat.slug}/` },
    { name: d.title, url },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    keywords: d.keyword,
    articleSection: pillar.name,
    inLanguage: SITE.locale,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    mainEntityOfPage: new URL(url, SITE.url).href,
    image: new URL(d.cover.src, SITE.url).href,
    author: { '@id': `${SITE.url}/#organizacion` },
    publisher: { '@id': `${SITE.url}/#organizacion` },
  },
];
---

<BaseLayout title={d.title} description={d.description} image={d.cover.src} type="article" noindex={d.draft} jsonLd={jsonLd}>
  <Header slot="header" />

  <section class="article-hero relative overflow-hidden px-5 pt-30 pb-[clamp(120px,14vw,190px)] text-white sm:pt-36">
    <div class="mx-auto max-w-250">
      <Breadcrumb
        items={[
          { name: 'Inicio', url: '/' },
          { name: 'Blog', url: '/blog/' },
          { name: cat.label, url: `/blog/categoria/${cat.slug}/` },
        ]}
        class="mb-7"
      />
      <a
        href={`/blog/categoria/${cat.slug}/`}
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-green-light/40 bg-green-light/10 px-4 py-1.5 text-[13px] font-bold text-green-light transition-colors hover:bg-green-light/20"
      >
        <span class="size-1.5 rounded-full bg-green-light" aria-hidden="true"></span>{cat.label}
      </a>
      <h1 class="mb-6 text-[clamp(2rem,min(4.4vw,7svh),3.5rem)] leading-[1.08] font-extrabold tracking-tight-display text-balance">{d.title}</h1>
      <p class="mb-8 max-w-190 text-[clamp(1.0625rem,1.5vw,1.25rem)] leading-[1.65] text-on-dark">{d.description}</p>
      <p class="m-0 flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px] font-semibold text-on-dark-muted">
        <span>Por el equipo técnico de {SITE.name}</span>
        <span aria-hidden="true" class="text-white/25">·</span>
        <time datetime={(d.updated ?? d.date).toISOString()}>{d.updated ? `Actualizado el ${formatDate(d.updated)}` : formatDate(d.date)}</time>
        <span aria-hidden="true" class="text-white/25">·</span>
        <span>{minutes} min de lectura</span>
      </p>
    </div>
  </section>

  <div class="relative z-1 mx-auto -mt-[clamp(90px,11vw,150px)] max-w-310 px-5">
    <figure class="m-0 overflow-hidden rounded-panel bg-surface shadow-panel">
      <Image src={d.cover} alt={d.coverAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1280px) 1200px, 100vw" loading="eager" fetchpriority="high" class="aspect-[21/9] w-full object-cover max-sm:aspect-[4/3]" />
    </figure>
  </div>

  {
    d.draft && (
      <div class="mx-auto mt-8 max-w-310 px-5">
        <p class="m-0 rounded-card border border-amber-300 bg-amber-50 px-5 py-4 text-[15px] leading-[1.6] text-ink">
          <strong>Borrador para revisión del cliente.</strong> No se publica ni se indexa hasta validarlo. Las notas amarillas marcan lo que falta confirmar (normas, precios o casos).
        </p>
      </div>
    )
  }

  <div class="mx-auto grid max-w-310 gap-12 px-5 pt-[clamp(40px,5vw,64px)] pb-[clamp(56px,7vw,96px)] lg:grid-cols-[240px_minmax(0,1fr)_280px] lg:gap-10 xl:gap-14">
    <aside class="max-lg:order-1 lg:sticky lg:top-28 lg:self-start" aria-label="Índice del artículo">
      {
        toc.length > 2 && (
          <details class="toc group rounded-card border border-line bg-surface p-5 lg:border-0 lg:bg-transparent lg:p-0">
            <summary class="flex cursor-pointer list-none items-center justify-between text-[13px] font-extrabold tracking-[0.12em] text-navy uppercase lg:mb-4">
              En este artículo
              <Icon d={ICON.plus} size={18} class="transition-transform group-open:rotate-45 lg:hidden" />
            </summary>
            <ol class="m-0 mt-4 list-none space-y-1 border-l border-line p-0 lg:mt-0">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-[14px] leading-[1.45] text-muted transition-colors hover:text-navy">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
    </aside>

    <article class="prose-nexos max-lg:order-2 min-w-0" data-draft={d.draft ? '' : undefined}>
      <Content />
    </article>

    <aside class="max-lg:order-3 lg:sticky lg:top-28 lg:self-start" aria-label="Cotiza con NEXOS">
      <div class="cta-card relative overflow-hidden rounded-card p-7 text-white">
        <p class="eyebrow mb-3 text-green-light">{pillar.short}</p>
        <p class="mb-3 text-[1.375rem] leading-[1.2] font-extrabold text-balance">{d.cta.label}</p>
        <p class="mb-6 text-[15px] leading-[1.6] text-on-dark">{d.cta.text}</p>
        <a href={quote} class="press mb-3 flex min-h-12 items-center justify-center gap-2 rounded-full bg-green px-5 font-extrabold text-ink shadow-cta">
          Cotiza con NEXOS <Icon d={ICON.arrow} size={17} stroke={2.4} />
        </a>
        <a
          href={whatsappUrl(`Hola NEXOS, leí "${d.title}" y quiero una cotización.`)}
          data-track="whatsapp_click"
          class="press flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/25 px-5 font-bold text-white hover:border-green-light"
        >
          <Icon d={ICON.whatsapp} size={18} /> Escríbenos por WhatsApp
        </a>
      </div>
      <a href={`/servicios/${pillar.slug}/`} class="mt-4 flex items-center justify-between gap-3 rounded-card border border-line bg-white px-5 py-4 text-[14px] font-bold text-navy transition-colors hover:border-blue">
        Ver servicio: {pillar.short} <Icon d={ICON.arrowUpRight} size={18} />
      </a>
    </aside>
  </div>

  {
    projects.length > 0 && (
      <section class="bg-blueprint px-5 py-[clamp(56px,min(7vw,9svh),96px)]" aria-labelledby="proyectos-relacionados">
        <div class="mx-auto max-w-310">
          <p class="eyebrow mb-3 text-blue">Casos reales</p>
          <h2 id="proyectos-relacionados" class="mb-9 text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1] font-extrabold text-navy text-balance">
            Proyectos de NEXOS relacionados con este tema
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((p) => (
              <a href={`/proyectos/${p.id}/`} class="group overflow-hidden rounded-card border border-line bg-white transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lift">
                <div class="aspect-[16/10] overflow-hidden bg-surface">
                  <Image src={p.data.cover} alt={`${p.data.type} — ${p.data.title}`} widths={[400, 640]} sizes="(min-width: 1024px) 380px, 50vw" class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                </div>
                <div class="p-6">
                  <p class="mb-2 text-[13px] font-semibold text-subtle">{p.data.place}</p>
                  <h3 class="mb-2 text-[1.125rem] leading-[1.3] font-extrabold text-navy">{p.data.title}</h3>
                  <p class="m-0 text-[14px] leading-[1.55] text-muted">{p.data.type}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="px-5 py-[clamp(56px,min(7vw,9svh),96px)]" aria-labelledby="sigue-leyendo">
        <div class="mx-auto max-w-310">
          <div class="mb-9 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow mb-3 text-blue">Sigue leyendo</p>
              <h2 id="sigue-leyendo" class="m-0 text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1] font-extrabold text-navy">
                Más guías de {cat.label}
              </h2>
            </div>
            <a href={`/blog/categoria/${cat.slug}/`} class="inline-flex items-center gap-2 font-extrabold text-blue">
              Ver todas <Icon d={ICON.arrow} size={16} stroke={2.4} />
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => <PostCard post={p} level="h3" />)}
          </div>
        </div>
      </section>
    )
  }

  <Cotizar service={d.pillar} />
  <Footer slot="footer" />
</BaseLayout>

<script>
  // Índice: abierto en escritorio, cerrado en móvil (no empuja el texto); resalta la sección visible.
  const toc = document.querySelector<HTMLDetailsElement>('details.toc');
  if (toc && matchMedia('(min-width: 1024px)').matches) toc.open = true;
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }

  // Borradores: los comentarios de pendientes del Markdown se muestran como notas visibles.
  const draft = document.querySelector<HTMLElement>('.prose-nexos[data-draft]');
  if (draft) {
    const walker = document.createTreeWalker(draft, NodeFilter.SHOW_COMMENT);
    const notes: Comment[] = [];
    while (walker.nextNode()) notes.push(walker.currentNode as Comment);
    for (const c of notes) {
      const text = c.data.trim();
      const m = text.match(/^(VALIDAR|PRECIO CLIENTE|CASO CLIENTE|FUENTES)\s*:?\s*([\s\S]*)$/);
      if (!m) continue;
      const el = document.createElement('aside');
      el.className = `nota-pendiente${m[1] === 'FUENTES' ? ' nota-fuentes' : ''}`;
      const tag = document.createElement('strong');
      tag.textContent = m[1];
      el.append(tag, ' ', m[2]);
      c.replaceWith(el);
    }
  }
</script>

<style>
  .article-hero {
    background-color: var(--color-ink);
    background-image:
      var(--dots-blue),
      var(--dots-green),
      radial-gradient(45% 70% at 90% 20%, rgb(29 79 160 / 0.6), transparent 70%),
      radial-gradient(30% 50% at 0% 90%, rgb(63 165 53 / 0.18), transparent 70%);
    background-size:
      var(--dots-size),
      100% 100%,
      100% 100%;
    background-position:
      var(--dots-position),
      0 0,
      0 0;
  }
  .cta-card {
    background-color: var(--color-ink);
    background-image:
      var(--dots-blue),
      radial-gradient(80% 60% at 100% 0%, rgb(29 79 160 / 0.7), transparent 70%);
    background-size:
      24px 24px,
      100% 100%;
    box-shadow: var(--shadow-panel);
  }
  .toc a[aria-current] {
    border-color: var(--color-green);
    color: var(--color-navy);
    font-weight: 700;
  }
</style>
