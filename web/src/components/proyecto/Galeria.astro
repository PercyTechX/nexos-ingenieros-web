---
/**
 * Galería de la ficha de proyecto: fila con scroll-snap (deslizable en móvil), flechas, contador y miniaturas.
 * Todas las fotos están en el HTML con su alt; la primera carga de inmediato (LCP) y el resto en diferido.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';

interface Props {
  images: ImageMetadata[];
  alt: string;
}
const { images, alt } = Astro.props;
const total = images.length;
---

<div class="gal" data-gal>
  <div class="stage relative overflow-hidden rounded-xl2 bg-ink shadow-[0_40px_90px_-30px_rgb(10_20_64/0.55)]">
    <ul class="track m-0 flex snap-x snap-mandatory list-none overflow-x-auto p-0" data-track aria-label={`Fotos del proyecto (${total})`}>
      {
        images.map((img, k) => (
          <li class="relative flex aspect-[4/3] w-full flex-none snap-center items-center justify-center sm:aspect-[16/10]" aria-label={`Foto ${k + 1} de ${total}`}>
            <Image
              src={img}
              alt=""
              aria-hidden="true"
              widths={[400]}
              sizes="400px"
              loading={k === 0 ? 'eager' : 'lazy'}
              class="absolute inset-0 size-full scale-110 object-cover opacity-35 blur-2xl"
            />
            <Image
              src={img}
              alt={`${alt} — foto ${k + 1} de ${total}`}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 1280px) 1240px, 100vw"
              loading={k === 0 ? 'eager' : 'lazy'}
              fetchpriority={k === 0 ? 'high' : undefined}
              class="relative size-full object-contain"
            />
          </li>
        ))
      }
    </ul>
    {
      total > 1 && (
        <>
          <button type="button" class="arrow press absolute top-1/2 left-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/92 text-navy shadow-lg backdrop-blur sm:left-5" data-prev aria-label="Foto anterior">
            <Icon d={ICON.arrow} size={18} stroke={2.4} class="rotate-180" />
          </button>
          <button type="button" class="arrow press absolute top-1/2 right-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/92 text-navy shadow-lg backdrop-blur sm:right-5" data-next aria-label="Foto siguiente">
            <Icon d={ICON.arrow} size={18} stroke={2.4} />
          </button>
          <span class="absolute right-4 bottom-4 rounded-full bg-ink/80 px-3 py-1.5 text-[13px] font-bold text-white backdrop-blur" aria-live="polite" data-counter>
            1 / {total}
          </span>
        </>
      )
    }
  </div>
  {
    total > 1 && (
      <div class="thumbs mt-3.5 flex gap-2.5 overflow-x-auto pb-1" role="group" aria-label="Elegir foto">
        {images.map((img, k) => (
          <button type="button" class="thumb press relative h-16 w-22 flex-none overflow-hidden rounded-xl border-2 border-transparent sm:h-20 sm:w-28" data-thumb={k} aria-label={`Ver foto ${k + 1}`} aria-current={k === 0 ? 'true' : undefined}>
            <Image src={img} alt="" widths={[160, 240]} sizes="112px" class="size-full object-cover" />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gal]').forEach((gal) => {
    const track = gal.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const thumbs = [...gal.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const counter = gal.querySelector('[data-counter]');
    let current = 0;

    const go = (k: number) => {
      const i = (k + slides.length) % slides.length;
      track.scrollTo({ left: slides[i].offsetLeft, behavior: 'smooth' });
    };
    const mark = (i: number) => {
      current = i;
      if (counter) counter.textContent = `${i + 1} / ${slides.length}`;
      thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      thumbs[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    // La foto visible se detecta con el scroll (sirve para flechas, miniaturas y deslizar con el dedo)
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && mark(slides.indexOf(e.target as HTMLElement))),
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    gal.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1));
    gal.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    gal.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current - 1);
      if (e.key === 'ArrowRight') go(current + 1);
    });
  });
</script>

<style>
  .track,
  .thumbs {
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar,
  .thumbs::-webkit-scrollbar {
    display: none;
  }
  .thumb {
    opacity: 0.55;
    transition:
      opacity 200ms ease-out,
      border-color 200ms ease-out;
  }
  .thumb[aria-current='true'] {
    opacity: 1;
    border-color: var(--color-green);
  }
  @media (hover: hover) and (pointer: fine) {
    .thumb:hover {
      opacity: 1;
    }
    .arrow {
      opacity: 0;
      transition:
        opacity 220ms ease-out,
        transform 160ms var(--ease-out-strong);
    }
    .stage:hover .arrow,
    .arrow:focus-visible {
      opacity: 1;
    }
  }
</style>
