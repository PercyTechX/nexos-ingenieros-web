---
/** Proyectos ejecutados (plano técnico): mapa de obras interactivo. Cada obra enlaza a /proyectos/[id]/. */
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import MapaObras from '../islands/MapaObras.svelte';
import { CITIES, PERU_PATH, PERU_VIEWBOX } from '../../data/peru-map';

const label = { mant: 'Mantenimiento', retail: 'Retail', obras: 'Obras e ingeniería', indeci: 'INDECI · ITSE' };
const entries = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const works = await Promise.all(
  entries.map(async (e) => {
    const thumb = await getImage({ src: e.data.cover, width: 208, height: 152, fit: 'cover', format: 'webp' });
    return {
      id: e.id,
      title: e.data.title,
      client: e.data.client,
      place: e.data.place,
      type: e.data.type,
      city: e.data.city,
      pillar: e.data.pillar,
      pillarLabel: label[e.data.pillar],
      photos: e.data.gallery.length + 1,
      thumb: thumb.src,
      href: `/proyectos/${e.id}/`,
    };
  }),
);
const cityCount = new Set(works.map((w) => w.city)).size;
---

<section id="proyectos" class="bg-blueprint relative overflow-hidden px-5 py-[clamp(56px,min(9vw,11svh),120px)]">
  <p class="outline-text pointer-events-none absolute top-9 -right-[2%] m-0 font-extrabold whitespace-nowrap text-transparent" aria-hidden="true" data-drift>
    OBRAS · PERÚ
  </p>
  <div class="relative mx-auto max-w-310">
    <div class="mb-6.5 max-w-200">
      <SectionHeading eyebrow="Proyectos ejecutados de mantenimiento y construcción en todo el Perú">
        Obras que <Fragment slot="accent">hablan por nosotros</Fragment>
      </SectionHeading>
      <p class="mt-2.5 text-[17px] text-muted">
        {works.length} proyectos en {cityCount} ciudades del Perú. Toca un punto del mapa para ver las obras de esa zona.
      </p>
    </div>
    <MapaObras client:visible works={works} cities={CITIES} path={PERU_PATH} viewBox={PERU_VIEWBOX} />
  </div>
</section>

<style>
  .outline-text {
    font-size: clamp(90px, 13vw, 210px);
    letter-spacing: -0.05em;
    line-height: 1;
    -webkit-text-stroke: 1.5px rgb(29 79 160 / 0.14);
  }
</style>
