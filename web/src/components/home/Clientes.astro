---
/**
 * Clientes (justo debajo del hero): tarjeta blanca flotante sobre un difuminado oscuro → claro que une el hero con Servicios.
 * Logos en 2 filas en sentidos opuestos, gris → color al pasar el cursor.
 * El título se mantiene como H2 real ("Empresas que confían en NEXOS Ingenieros") para SEO.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const clientes = (await getCollection('clientes')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'es'));
const rows = [clientes.filter((_, k) => k % 2 === 0), clientes.filter((_, k) => k % 2 === 1)];
---

<section id="clientes" class="fade relative overflow-hidden px-5 pb-[clamp(28px,4vw,48px)]">
  <span class="fade-dots pointer-events-none absolute inset-0" aria-hidden="true"></span>
  <div class="card relative mx-auto max-w-310 overflow-hidden rounded-[28px] border border-white/70 bg-white py-6 sm:py-8">
  <h2 class="mx-auto mb-4 max-w-[calc(77.5rem+2.5rem)] px-5 text-center text-[13px] font-bold tracking-[0.16em] text-subtle uppercase">
    Empresas que <span class="text-green-dark">confían en NEXOS Ingenieros</span>
  </h2>
  <div class="flex flex-col gap-1">
    {
      rows.map((row, r) => (
        <div class="row overflow-hidden">
          <div class:list={['track flex w-max', r === 1 && 'reverse']}>
            {[0, 1].map((copy) => (
              <ul class="m-0 flex list-none items-center p-0" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map((c) => (
                  <li class="logo flex h-14 flex-none items-center justify-center px-[clamp(20px,2.6vw,36px)]">
                    <Image src={c.data.logo} alt={copy === 0 ? c.data.name : ''} height={48} densities={[1, 2]} class="h-auto max-h-9 w-auto max-w-36 object-contain" />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  </div>
</section>

<style>
  .row {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    animation: marquee 44s linear infinite;
  }
  .track.reverse {
    animation-direction: reverse;
    animation-duration: 50s;
  }
  .row:hover .track {
    animation-play-state: paused;
  }
  .logo :global(img) {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 280ms ease-out,
      opacity 280ms ease-out,
      transform 280ms var(--ease-out-strong);
  }
  .logo:hover :global(img) {
    filter: none;
    opacity: 1;
    transform: scale(1.06);
  }
  /* Difuminado del hero (ink) al fondo claro de Servicios, pasando por el azul de marca */
  .fade {
    background: linear-gradient(
      to bottom,
      var(--color-ink) 0%,
      #10245f 22%,
      var(--color-blue) 46%,
      #9db8ea 72%,
      var(--color-surface-blue) 100%
    );
  }
  /* Los puntos del hero continúan y se desvanecen hacia lo claro */
  .fade-dots {
    background-image: var(--dots-blue), var(--dots-green);
    background-size: var(--dots-size);
    background-position: var(--dots-position);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 55%);
    mask-image: linear-gradient(to bottom, #000, transparent 55%);
  }
  .card {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 30px 60px -20px rgb(10 20 64 / 0.35),
      0 12px 24px -12px rgb(10 20 64 / 0.2);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
    .track ul[aria-hidden] {
      display: none;
    }
  }
</style>
