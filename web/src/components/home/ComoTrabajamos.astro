---
/** Cómo trabajamos (oscuro): 4 pasos. */
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { STEPS } from '../../data/home';
---

<section id="como-trabajamos" class="relative overflow-hidden px-5 py-[clamp(80px,10vw,128px)] text-white" style="background: linear-gradient(160deg, #0a1440 0%, #10245f 65%, #143a7a 100%)">
  <div class="mx-auto max-w-310">
    <div class="mb-11 flex flex-wrap items-end justify-between gap-x-12 gap-y-5">
      <SectionHeading eyebrow="Cómo trabajamos en mantenimiento y obras" tone="dark" class="min-w-0 flex-[1_1_480px]">
        De la visita técnica a la <Fragment slot="accent">entrega final</Fragment>
      </SectionHeading>
      <p class="m-0 flex-[0_1_420px] text-[17px] leading-relaxed text-on-dark" data-reveal="right">
        Un proceso simple y ordenado, con un solo equipo responsable en Lima, Ica y provincias.
      </p>
    </div>
    <ol class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        STEPS.map((s, k) => (
          <li class="flex flex-col gap-3.5 rounded-card border border-white/12 bg-white/5 px-5.5 py-6.5" data-reveal="up" data-reveal-delay={k * 0.1}>
            <span class="flex items-center justify-between">
              <span class="flex size-14 items-center justify-center rounded-[18px] border border-green-light/35 bg-green-light/14 text-green-light">
                <Icon d={s.icon} size={26} stroke={1.8} />
              </span>
              <span class="step-num text-[54px] leading-none font-extrabold tracking-[-0.05em] text-transparent" aria-hidden="true">
                {s.n}
              </span>
            </span>
            <h3 class="m-0 text-xl font-extrabold">{s.title}</h3>
            <p class="m-0 text-[15px] leading-relaxed text-on-dark">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="#cotizar" class="press inline-flex min-h-13 items-center rounded-full bg-green px-6 font-extrabold text-ink">Agenda tu visita técnica</a>
    </div>
  </div>
</section>

<style>
  .step-num {
    -webkit-text-stroke: 1.5px rgb(143 216 138 / 0.5);
  }
</style>
