---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';
import { SITE, PILLARS, whatsappUrl } from '../../config/site';
import logoBlanco from '../../assets/marca/logo-blanco.webp';

const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => url);
---

<footer class="footer bg-ink px-5 pt-20 pb-8 text-on-dark">
  <div class="mx-auto max-w-310">
    <div class="flex flex-wrap items-center justify-between gap-6 border-b border-white/12 pb-12" data-reveal="zoom">
      <p class="m-0 min-w-0 flex-[1_1_520px] text-section font-extrabold tracking-tight-display text-white">
        ¿Tu local necesita <span class="text-green-light">atención hoy?</span>
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={whatsappUrl()}
          class="press inline-flex min-h-14 items-center gap-2.5 rounded-full bg-green px-6 font-extrabold text-ink"
          data-track="whatsapp_click"
        >
          <Icon d={ICON.whatsapp} size={20} />{SITE.phone}
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="press inline-flex min-h-14 items-center rounded-full border border-white/35 px-6 font-bold text-white"
          data-track="correo_click">{SITE.email}</a
        >
      </div>
    </div>

    <div class="grid gap-9 pt-11 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <Image src={logoBlanco} alt="NEXOS Ingenieros" height={110} class="h-24 w-auto" />
        <p class="mt-3.5 text-[15px] leading-relaxed">{SITE.slogan}.</p>
      </div>
      <div>
        <p class="mb-3.5 text-[15px] font-bold text-white">Servicios</p>
        <ul class="space-y-2 text-sm leading-snug">
          {
            PILLARS.map((p) => (
              <li>
                <a href={`/servicios/${p.slug}/`} class="hover:text-white">
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="mb-3.5 text-[15px] font-bold text-white">Sedes en Lima e Ica</p>
        <ul class="space-y-2 text-sm">
          {SITE.offices.map((o) => <li>{o.locality}, {o.region} – Perú</li>)}
          <li><a href={SITE.phoneHref} class="hover:text-white" data-track="telefono_click">{SITE.phone}</a></li>
          {SITE.hours && <li>Horario: {SITE.hours}</li>}
        </ul>
      </div>
      <div>
        <p class="mb-3.5 text-[15px] font-bold text-white">Enlaces</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/proyectos/" class="hover:text-white">Proyectos ejecutados</a></li>
          <li><a href="/nosotros/" class="hover:text-white">Nosotros y certificaciones</a></li>
          <li><a href="/blog/" class="hover:text-white">Blog</a></li>
          <li><a href="/politica-de-privacidad/" class="hover:text-white">Política de privacidad</a></li>
        </ul>
        {
          socials.length > 0 && (
            <ul class="mt-4 flex gap-3 text-sm">
              {socials.map(([name, url]) => (
                <li>
                  <a href={url} class="capitalize hover:text-white" rel="noopener">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap justify-between gap-2.5 border-t border-white/12 pt-5 text-[13px] text-on-dark-muted"
    >
      <span>© {year} {SITE.name}. Todos los derechos reservados.</span>
      <a href="#contenido" class="text-on-dark hover:text-white">Volver arriba ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-image: var(--dots-blue), var(--dots-green);
    background-size: var(--dots-size);
    background-position: var(--dots-position);
  }
</style>
