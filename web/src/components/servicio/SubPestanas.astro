---
/**
 * Sub-servicios, variante "Recorrido técnico": pestañas a la izquierda que cambian el panel (foto + texto + lista).
 * Todos los paneles están en el HTML (SEO); sin JS se ven todos uno debajo del otro.
 */
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';
import type { SubService } from '../../data/servicios';

interface Props {
  eyebrow: string;
  subs: SubService[];
  sectors: string[];
}
const { eyebrow, subs, sectors } = Astro.props;
---

<section id="especialidades" class="bg-blueprint relative overflow-clip px-5 py-[clamp(56px,min(7vw,9svh),96px)]">
  <div class="relative mx-auto max-w-310">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <SectionHeading eyebrow={eyebrow} class="min-w-0 flex-[1_1_520px]">
        Cuatro especialidades, <Fragment slot="accent">un solo equipo</Fragment>
      </SectionHeading>
      <p class="m-0 flex-[0_1_400px] text-[15px] leading-relaxed text-muted" data-reveal="right">
        <strong class="text-navy">Lo hacemos en:</strong>
        {sectors.join(' · ')}.
      </p>
    </div>

    <div class="tabs grid gap-5 lg:grid-cols-[minmax(260px,340px)_1fr]" data-tabs>
      <div role="tablist" aria-label="Especialidades" class="tablist hidden gap-2.5 lg:flex lg:flex-col">
        {
          subs.map((s, k) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={k === 0 ? 'true' : 'false'}
              tabindex={k === 0 ? 0 : -1}
              class="tab press flex items-center gap-3.5 rounded-[18px] border border-line bg-white/80 p-3.5 text-left"
            >
              <span class="ico flex size-11 flex-none items-center justify-center rounded-[14px] bg-surface-blue text-navy">
                <Icon d={s.icon} size={20} stroke={2} />
              </span>
              <span class="flex min-w-0 flex-col">
                <span class="num text-[11px] font-extrabold tracking-[0.14em] text-subtle">0{k + 1}</span>
                <span class="text-[15px] leading-snug font-extrabold text-navy">{s.title}</span>
              </span>
              <Icon d={ICON.arrow} size={16} stroke={2.4} class="go ml-auto flex-none text-green-dark" />
            </button>
          ))
        }
      </div>

      <div class="panels flex flex-col gap-5">
        {
          subs.map((s, k) => (
            <article
              id={`panel-${s.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${s.id}`}
              class="panel grid overflow-hidden rounded-xl2 border border-line bg-white shadow-[0_20px_50px_-20px_rgb(14_26_79/0.18)] md:grid-cols-[1fr_1.1fr]"
              data-panel
              data-index={k}
            >
              <div class:list={['relative min-h-60 overflow-hidden', s.cutout ? 'cutout flex items-end justify-center' : 'bg-surface']}>
                <Image
                  src={s.image}
                  alt={s.imageAlt}
                  widths={s.cutout ? [360, 720] : [520, 1040]}
                  sizes="(min-width: 1024px) 420px, (min-width: 768px) 45vw, 100vw"
                  class:list={[s.cutout ? 'max-h-[86%] w-auto object-contain' : 'absolute inset-0 size-full object-cover']}
                />
              </div>
              <div class="flex flex-col p-6 sm:p-8">
                <span class="mb-3 inline-flex w-fit items-center gap-2 rounded-full bg-green/10 px-3 py-1.5 text-[11px] font-extrabold tracking-[0.12em] text-green-dark uppercase">
                  <Icon d={s.icon} size={14} stroke={2.2} /> Especialidad 0{k + 1}
                </span>
                <h3 class="mb-2.5 text-[clamp(22px,2.2vw,28px)] leading-tight font-extrabold text-navy">{s.title}</h3>
                <p class="mb-5 text-[15px] leading-relaxed text-muted">{s.text}</p>
                <ul class="m-0 mb-7 grid list-none gap-2.5 p-0">
                  {
                    s.items.map((it) => (
                      <li class="flex items-start gap-2.5 text-[15px] leading-snug text-text">
                        <span class="mt-0.5 flex size-5 flex-none items-center justify-center rounded-full bg-green text-white">
                          <Icon d={ICON.check} size={12} stroke={3} />
                        </span>
                        {it}
                      </li>
                    ))
                  }
                </ul>
                <a href="#cotizar" class="press mt-auto inline-flex min-h-12 w-fit items-center gap-2 rounded-full bg-navy px-5.5 text-sm font-extrabold text-white">
                  Cotizar esta especialidad <Icon d={ICON.arrow} size={15} stroke={2.4} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // En escritorio: pestañas (un panel a la vez). En móvil/tablet y sin JS: todos los paneles apilados.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const desktop = window.matchMedia('(min-width: 1024px)');
    let current = 0;

    const render = () => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === current));
        t.tabIndex = k === current ? 0 : -1;
      });
      panels.forEach((p, k) => (p.hidden = desktop.matches && k !== current));
    };
    const select = (k: number, focus = false) => {
      current = (k + tabs.length) % tabs.length;
      render();
      if (focus) tabs[current].focus();
    };

    root.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tabs.indexOf(tab));
    });
    root.addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).matches('[role="tab"]')) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') (e.preventDefault(), select(current + 1, true));
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') (e.preventDefault(), select(current - 1, true));
    });
    desktop.addEventListener('change', render);
    render();
  }
</script>

<style>
  .cutout {
    background:
      radial-gradient(60% 70% at 50% 60%, rgb(90 142 234 / 0.35), transparent 70%),
      linear-gradient(160deg, #0a1440, #163a86);
  }
  .tab {
    transition:
      background-color 220ms ease-out,
      border-color 220ms ease-out,
      box-shadow 260ms ease-out,
      transform 260ms var(--ease-out-strong);
  }
  .tab .ico,
  .tab .go {
    transition:
      background-color 220ms ease-out,
      color 220ms ease-out,
      opacity 220ms ease-out,
      transform 260ms var(--ease-out-strong);
  }
  .tab .go {
    opacity: 0;
    transform: translateX(-6px);
  }
  .tab[aria-selected='true'] {
    background: #fff;
    border-color: var(--color-navy);
    box-shadow: 0 16px 36px -14px rgb(14 26 79 / 0.3);
  }
  .tab[aria-selected='true'] .ico {
    background: var(--color-navy);
    color: #fff;
  }
  .tab[aria-selected='true'] .num {
    color: var(--color-green-dark);
  }
  .tab[aria-selected='true'] .go {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .tab:hover {
      background: #fff;
      transform: translateX(3px);
    }
  }
  .panel:not([hidden]) {
    animation: panel-in 380ms var(--ease-out-strong);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel:not([hidden]) {
      animation: none;
    }
  }
</style>
