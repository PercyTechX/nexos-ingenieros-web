---
/**
 * Proyectos de un pilar (páginas de servicio). Cada tarjeta enlaza a su ficha /proyectos/[id]/.
 * layout="grid": cuadrícula de 4 columnas · layout="carrusel": fila horizontal con scroll y flechas.
 * Se publica solo el cliente final (campo `client`), nunca el intermediario.
 */
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import ProyectoCard from '../proyecto/ProyectoCard.astro';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';
import type { PillarId } from '../../config/site';

interface Props {
  pillar: PillarId;
  eyebrow: string;
  layout?: 'grid' | 'carrusel';
  /** Proyecto a excluir (la ficha actual, en "Más proyectos"). */
  exclude?: string;
  hook?: string;
  accent?: string;
  bg?: 'white' | 'surface';
}
const { pillar, eyebrow, layout = 'grid', exclude, hook = 'Obras que', accent = 'ya entregamos', bg = 'white' } = Astro.props;
const proyectos = (await getCollection('proyectos', (p) => p.data.pillar === pillar && p.id !== exclude)).sort((a, b) => a.data.order - b.data.order);
const carrusel = layout === 'carrusel';
---

<section id="proyectos" class:list={[bg === 'white' ? 'bg-white' : 'bg-surface', 'px-5 py-[clamp(56px,min(7vw,9svh),96px)]']}>
  <div class="mx-auto max-w-310">
    <div class="mb-9 flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <SectionHeading eyebrow={eyebrow} class="min-w-0 flex-[1_1_520px]">
        {hook}{' '}<Fragment slot="accent">{accent}</Fragment>
      </SectionHeading>
      <div class="flex items-center gap-3">
        {
          carrusel && (
            <span class="hidden gap-2 sm:flex" data-carrusel-nav>
              <button type="button" class="nav press flex size-12 items-center justify-center rounded-full border-2 border-navy text-navy" data-dir="-1" aria-label="Proyectos anteriores">
                <Icon d={ICON.arrow} size={18} stroke={2.4} class="rotate-180" />
              </button>
              <button type="button" class="nav press flex size-12 items-center justify-center rounded-full border-2 border-navy bg-navy text-white" data-dir="1" aria-label="Más proyectos">
                <Icon d={ICON.arrow} size={18} stroke={2.4} />
              </button>
            </span>
          )
        }
        <a href="/proyectos/" class="press inline-flex min-h-12 items-center gap-2 rounded-full px-2 font-extrabold text-blue">
          Ver todos los proyectos <Icon d={ICON.arrow} size={16} stroke={2.4} />
        </a>
      </div>
    </div>

    <ul
      class:list={[
        'm-0 list-none p-0',
        carrusel
          ? 'track -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-4'
          : 'grid gap-4 sm:grid-cols-2 lg:grid-cols-4',
      ]}
      data-carrusel={carrusel || undefined}
    >
      {
        proyectos.map((p, k) => (
          <li class:list={[carrusel && 'w-[min(78vw,340px)] flex-none snap-start']} data-reveal="up" data-reveal-delay={(k % 4) * 0.06}>
            <ProyectoCard p={p} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((track) => {
    const nav = track.closest('section')?.querySelector('[data-carrusel-nav]');
    nav?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-dir]');
      if (!btn) return;
      const card = track.querySelector('li');
      const step = card ? card.getBoundingClientRect().width + 16 : 340;
      track.scrollBy({ left: Number(btn.dataset.dir) * step * 2, behavior: 'smooth' });
    });
  });
</script>

<style>
  .track {
    scrollbar-width: thin;
    scrollbar-color: var(--color-blue-soft) transparent;
  }
</style>
