---
/**
 * Listado del blog (portada y categorías): hero oscuro con H1 y filtro por pilar, rejilla de tarjetas y paginación.
 * El primer artículo de la página 1 va destacado.
 */
import Breadcrumb from '../ui/Breadcrumb.astro';
import PostCard from './PostCard.astro';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';
import { CATEGORIES, SHOW_DRAFTS, type Post } from '../../lib/blog';

interface Props {
  eyebrow: string;
  h1: string;
  intro: string;
  posts: Post[];
  crumbs: { name: string; url?: string }[];
  /** Slug de la categoría activa (undefined = "Todos"). */
  active?: string;
  /** Total de artículos del filtro (para el contador). */
  total: number;
  page?: { current: number; last: number; prev?: string; next?: string };
}
const { eyebrow, h1, intro, posts, crumbs, active, total, page } = Astro.props;
const featured = true; // el primero de cada página va destacado (1 + 12 = 4 filas exactas)
const chips = [{ slug: undefined, label: 'Todos', href: '/blog/' }, ...CATEGORIES.map((c) => ({ slug: c.slug, label: c.label, href: `/blog/categoria/${c.slug}/` }))];
const drafts = posts.filter((p) => p.data.draft).length;
---

<section class="blog-hero relative overflow-hidden px-5 pt-30 pb-12 text-white sm:pt-36 sm:pb-14">
  <div class="mx-auto max-w-310">
    <Breadcrumb items={crumbs} class="mb-6" />
    <p class="eyebrow mb-4 text-green-light">{eyebrow}</p>
    <h1 class="mb-5 max-w-230 text-[clamp(2.125rem,min(4.2vw,7svh),3.75rem)] leading-[1.05] font-extrabold tracking-tight-display text-balance">{h1}</h1>
    <p class="mb-9 max-w-170 text-lg leading-[1.7] text-on-dark">{intro}</p>
    <nav aria-label="Categorías del blog">
      <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
        {
          chips.map((c) => {
            const on = c.slug === active;
            return (
              <li>
                <a
                  href={c.href}
                  aria-current={on ? 'page' : undefined}
                  class:list={[
                    'press inline-flex min-h-11 items-center rounded-full border px-5 text-[14px] font-bold transition-colors',
                    on ? 'border-green bg-green text-ink' : 'border-white/25 text-white hover:border-green-light hover:text-green-light',
                  ]}
                >
                  {c.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</section>

<section class="bg-blueprint px-5 py-[clamp(48px,min(6vw,8svh),80px)]">
  <div class="mx-auto max-w-310">
    <p class="mb-7 text-[14px] font-semibold text-subtle">
      {total} {total === 1 ? 'artículo' : 'artículos'}
      {SHOW_DRAFTS && drafts > 0 && <span class="ml-2 rounded-full bg-amber-200 px-2.5 py-1 text-[12px] font-bold text-ink">Vista previa: incluye borradores</span>}
    </p>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, k) => <PostCard post={post} featured={featured && k === 0} />)}
    </div>

    {
      page && page.last > 1 && (
        <nav aria-label="Paginación del blog" class="mt-12 flex items-center justify-center gap-3">
          {page.prev ? (
            <a href={page.prev} rel="prev" class="press inline-flex min-h-12 items-center gap-2 rounded-full border border-line bg-white px-5 font-bold text-navy hover:border-blue">
              <Icon d={ICON.arrow} size={16} stroke={2.4} class="rotate-180" /> Anteriores
            </a>
          ) : (
            <span class="inline-flex min-h-12 items-center rounded-full px-5 font-bold text-subtle/50">Anteriores</span>
          )}
          <span class="px-2 text-[14px] font-semibold text-subtle">
            Página {page.current} de {page.last}
          </span>
          {page.next ? (
            <a href={page.next} rel="next" class="press inline-flex min-h-12 items-center gap-2 rounded-full bg-navy px-5 font-bold text-white hover:bg-blue">
              Siguientes <Icon d={ICON.arrow} size={16} stroke={2.4} />
            </a>
          ) : (
            <span class="inline-flex min-h-12 items-center rounded-full px-5 font-bold text-subtle/50">Siguientes</span>
          )}
        </nav>
      )
    }
  </div>
</section>

<style>
  .blog-hero {
    background-color: var(--color-ink);
    background-image:
      var(--dots-blue),
      var(--dots-green),
      radial-gradient(40% 70% at 85% 30%, rgb(29 79 160 / 0.55), transparent 70%),
      radial-gradient(30% 50% at 5% 100%, rgb(63 165 53 / 0.18), transparent 70%);
    background-size:
      var(--dots-size),
      100% 100%,
      100% 100%;
    background-position:
      var(--dots-position),
      0 0,
      0 0;
  }
</style>
