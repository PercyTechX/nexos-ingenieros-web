---
/** Tarjeta de artículo para el listado del blog y los relacionados. `featured` = tarjeta ancha con imagen al costado. */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { ICON } from '../ui/icons';
import { categoryOf, readingTime, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  featured?: boolean;
  /** Nivel del título (h2 en listados, h3 dentro de una sección con H2). */
  level?: 'h2' | 'h3';
}
const { post, featured = false, level = 'h2' } = Astro.props;
const { title, description, cover, coverAlt, pillar, draft } = post.data;
const cat = categoryOf(pillar);
const Heading = level;
---

<article
  data-reveal
  class:list={[
    'group relative flex overflow-hidden rounded-card border border-line bg-white shadow-[0_10px_30px_rgb(14_26_79/0.06)] transition-[transform,box-shadow] duration-300 ease-[var(--ease-out-strong)] hover:-translate-y-1 hover:shadow-lift',
    featured ? 'flex-col md:col-span-2 md:grid md:grid-cols-[1.15fr_1fr] lg:col-span-3' : 'flex-col',
  ]}
>
  <div class:list={['relative overflow-hidden bg-surface', featured ? 'aspect-[16/10] md:aspect-auto md:h-full' : 'aspect-[16/10]']}>
    <Image
      src={cover}
      alt={coverAlt}
      widths={featured ? [480, 760, 1100] : [400, 640]}
      sizes={featured ? '(min-width: 1024px) 640px, 100vw' : '(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw'}
      class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-strong)] group-hover:scale-[1.04]"
    />
    <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-[12px] font-bold text-navy shadow-sm">
      <span class="size-1.5 rounded-full bg-green" aria-hidden="true"></span>{cat.label}
    </span>
    {draft && <span class="absolute top-4 right-4 rounded-full bg-amber-300 px-3 py-1.5 text-[11px] font-extrabold tracking-wide text-ink uppercase">Borrador</span>}
  </div>
  <div class:list={['flex flex-1 flex-col', featured ? 'p-7 md:p-10' : 'p-6']}>
    <p class="mb-3 text-[13px] font-semibold text-subtle">{readingTime(post.body)} min de lectura</p>
    <Heading class:list={['mb-3 font-extrabold text-navy text-balance', featured ? 'text-[clamp(1.5rem,2.6vw,2.125rem)] leading-[1.15]' : 'text-[1.1875rem] leading-[1.3]']}>
      <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </Heading>
    <p class:list={['mb-6 text-muted', featured ? 'text-[17px] leading-[1.65]' : 'line-clamp-3 text-[15px] leading-[1.6]']}>{description}</p>
    <span class="mt-auto inline-flex items-center gap-2 text-[14px] font-extrabold text-blue">
      Leer artículo <Icon d={ICON.arrow} size={16} stroke={2.4} class="transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  </div>
</article>
